{
  "name": "control-roll",
  "version": "1.0.0",
  "main": "electron-admin.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dist:admin": "electron-builder --win nsis -c.extraMetadata.main=electron-admin.js -c.productName=\"Control Roll Admin\""
  },
  "build": {
    "appId": "com.controlroll.admin",
    "productName": "Control Roll Admin",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Control Roll Admin"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "@tailwindcss/postcss": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
